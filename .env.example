# OpenRouter — obtenha sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Cabeçalhos enviados ao OpenRouter (aparecem nas estatísticas da sua conta)
OPENROUTER_HTTP_REFERER=https://github.com/munirnour1/aurora-safeguard
OPENROUTER_X_TITLE=Aurora Safeguard - Modulo 02

# Parâmetros do LLM principal
TEMPERATURE=0.7
MAX_TOKENS=1000

# Guardrails — por padrão ligados; use a flag --unsafe na CLI para desligar
GUARDRAILS_ENABLED=true