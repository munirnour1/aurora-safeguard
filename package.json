{
  "name": "aurora-safeguard",
  "version": "0.1.0",
  "description": "Guardrails & prompt injection demo — Aurora domain. Based on module 02 exercise.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
  "chat": "node --experimental-strip-types --env-file .env src/index.ts",
  "chat:professora": "node --experimental-strip-types --env-file .env src/index.ts --user professora --message \"Leia o material da aula de história\"",
  "chat:alice:safe": "node --experimental-strip-types --env-file .env src/index.ts --user alice --prompt-path prompts/user/solicitar-material.txt",
  "chat:alice:unsafe:material": "node --experimental-strip-types --env-file .env src/index.ts --user alice --unsafe --prompt-path prompts/user/solicitar-material.txt",
  "chat:alice:unsafe:rag": "node --experimental-strip-types --env-file .env src/index.ts --user alice --unsafe --prompt-path prompts/user/enriquecer-com-rag.txt",
  "langgraph:serve": "npx @langchain/langgraph-cli dev"
},
  "keywords": [
    "langchain",
    "langgraph",
    "security",
    "prompt-injection",
    "guardrails",
    "openrouter",
    "aurora"
  ],
  "author": "Munir Nour",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.1.19",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.2.7",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "langchain": "^1.2.17",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}